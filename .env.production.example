# Copy to .env.production on the server and fill in. Never commit the real file.

# Public domain whose DNS A record points at the server (Caddy gets a TLS cert for it).
DOMAIN=sitevoice.example.com

POSTGRES_USER=sitevoice
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=sitevoice

# 32+ random characters each, e.g. `openssl rand -hex 32`. The API refuses to start otherwise.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Password given to the seeded users if you run `npx prisma db seed`. Use a strong one.
SEED_PASSWORD=
