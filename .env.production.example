# Copy to .env.production on the server and fill in. Never commit the real file.
#   cp .env.production.example .env.production && nano .env.production

# --- Where browsers reach the apps -------------------------------------------------------
# Use the server's public IP or domain. These must match exactly what you type in the browser.
# WEB_ORIGIN is the allowed origin for CORS; NEXT_PUBLIC_API_URL is baked into the web build,
# so rebuild (`up -d --build`) after changing it.
WEB_ORIGIN=http://YOUR_SERVER_IP:3000
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000/api

# Ports published on the host. Open both in the firewall: `sudo ufw allow 3000,4000/tcp`
WEB_PORT=3000
API_PORT=4000

# false while you serve over plain http (browsers drop secure cookies on http).
# Set true once the site is behind HTTPS.
COOKIE_SECURE=false
# true only if a reverse proxy sits in front of the API (so rate limits see real client IPs).
TRUST_PROXY=false

# --- Database ----------------------------------------------------------------------------
POSTGRES_USER=sitevoice
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=sitevoice

# --- Secrets -----------------------------------------------------------------------------
# 32+ random characters, e.g. `openssl rand -hex 32`. The API refuses to start otherwise.
JWT_ACCESS_SECRET=

# --- First Admin account (used once by the seed step) --------------------------------------
# Creates the four roles and this Admin only. Sign in, then create sites and users in the app.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_PASSWORD=

# Attachments are stored in this S3 bucket (private; the API streams files so ticket permissions apply).
# Give the host an IAM role with s3:PutObject, s3:GetObject and s3:DeleteObject on the bucket, or set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.
S3_BUCKET=
S3_REGION=ap-south-1
S3_PREFIX=attachments/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Behind nginx + HTTPS (see README "HTTPS with nginx") -----------------------------------
# 127.0.0.1 makes ports 3000/4000 reachable only from the server itself (via nginx).
# Default 0.0.0.0 publishes them to the internet.
BIND_ADDR=0.0.0.0
