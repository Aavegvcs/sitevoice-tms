# Copy to .env.production on the server and fill in. Never commit the real file.

# Where browsers reach the apps. Use the server's public IP or domain.
# WEB_ORIGIN must match exactly what you type in the browser (CORS).
WEB_ORIGIN=http://YOUR_SERVER_IP:3000
# Baked into the web build. Also put it in apps/web/.env.local, or leave it here to override that file.
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000/api

# Ports published on the host (open both in the EC2 security group).
WEB_PORT=3000
API_PORT=4000

# false while you serve over plain http (cookies are rejected by browsers otherwise).
# Set true once the site is behind HTTPS.
COOKIE_SECURE=false

POSTGRES_USER=sitevoice
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=sitevoice

# 32+ random characters each, e.g. `openssl rand -hex 32`. The API refuses to start otherwise.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Password given to the seeded users if you run `npx prisma db seed`. Use a strong one.
SEED_PASSWORD=
