PORT=4000
WEB_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql://complaint:complaint@localhost:5434/sitevoice?schema=public
# Required. Use a random string of 32+ characters in production (the API refuses to start otherwise).
JWT_ACCESS_SECRET=change-me-in-development
# Attachments: set S3_BUCKET to store them in AWS S3 (credentials from the AWS default chain).
# Left unset, files go to local disk under ./uploads (development only).
S3_BUCKET=
S3_REGION=ap-south-1
S3_PREFIX=attachments/
